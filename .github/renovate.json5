{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  // Renovate only bumps the upstream chart in .chart-attributes. It never
  // touches its own config or the workflows, and nothing merges without review:
  // a merge to main publishes the package to the Marketplace.
  enabledManagers: [
    'custom.regex',
  ],
  configMigration: false,
  automerge: false,
  labels: [
    'automated',
    'renovate',
  ],
  separateMultipleMajor: true,
  customManagers: [
    {
      customType: 'regex',
      description: 'Bump the upstream Helm chart in .chart-attributes',
      managerFilePatterns: [
        '/(^|/)\\.chart-attributes$/',
      ],
      matchStringsStrategy: 'combination',
      matchStrings: [
        'CHART_NAME=(?<depName>.+)',
        'CHART_VERSION=(?<currentValue>.+)',
        'REPO_URL=(?<registryUrl>.+)',
      ],
      datasourceTemplate: 'helm',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ['major'],
      addLabels: ['major-update'],
    },
    {
      matchUpdateTypes: ['minor'],
      addLabels: ['minor-update'],
    },
    {
      matchUpdateTypes: ['patch'],
      addLabels: ['patch-update'],
    },
  ],
}
